generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String?
  googleId      String?        @unique
  nsfw          Boolean        @default(false)
  role          String         @default("USER")
  isVip         Boolean        @default(false)
  adsWatched    Int            @default(0)
  adsClicked    Int            @default(0)
  pagesViewed   Int            @default(0)
  timeSpent     Int            @default(0)
  isBanned      Boolean        @default(false)
  lastActiveAt  DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookmarks     Bookmark[]
  history       History[]
  libraries     Library[]
  progress      Progress[]
  ratings       Rating[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model DailyMetric {
  id                String   @id @default(uuid())
  date              DateTime @unique @default(now())
  newUsers          Int      @default(0)
  newGuests         Int      @default(0)
  chaptersRead      Int      @default(0)
  guestChaptersRead Int      @default(0)
  adsWatched        Int      @default(0)
  adsClicked        Int      @default(0)
  adImpressions     Int      @default(0)
  revenue           Float    @default(0)
  traffic           Int      @default(0)
  guestTraffic      Int      @default(0)
  totalTimeMs       BigInt   @default(0)

  @@map("daily_metrics")
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model SearchKeyword {
  keyword   String   @id
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("search_keywords")
}

model Announcement {
  id        String   @id @default(uuid())
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("announcements")
}

model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}

model BannedIp {
  ip        String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("banned_ips")
}

model Manga {
  id            String          @id
  title         String
  cover         String?
  description   String?
  status        String?
  genres        String[]        @default([])
  nsfw          Boolean         @default(false)
  rating        String?
  lastChapter   String?
  lastChapterId String?
  updateDate    String?
  source        String          @default("mangadex")
  updatedAt     DateTime        @updatedAt
  cachedAt      DateTime        @default(now())
  readCount     Int             @default(0)
  isHidden      Boolean         @default(false)
  bookmarks     Bookmark[]
  chapters      Chapter[]
  guestActivity GuestActivity[]
  history       History[]
  libraryItems  LibraryItem[]
  popularity    Popularity?
  progress      Progress[]
  ratings       Rating[]

  @@index([readCount])
  @@index([isHidden])
  @@map("manga")
}

model Popularity {
  mangaId           String   @id
  totalReadChapters Int      @default(0)
  totalChapters     Int      @default(0)
  uniqueUsersCount  Int      @default(0)
  score             Float    @default(0)
  updatedAt         DateTime @updatedAt
  manga             Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@index([score])
  @@map("popularity")
}

model Chapter {
  id        String     @id
  mangaId   String
  number    Float
  title     String?
  pages     Json       @default("[]")
  sources   Json       @default("[]")
  cachedAt  DateTime   @default(now())
  bookmarks Bookmark[]
  manga     Manga      @relation(fields: [mangaId], references: [id])
  history   History[]
  progress  Progress[]

  @@unique([mangaId, number])
  @@map("chapters")
}

model Library {
  id        String        @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     LibraryItem[]

  @@unique([userId, name])
  @@map("libraries")
}

model LibraryItem {
  libraryId String
  mangaId   String
  addedAt   DateTime @default(now())
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  manga     Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@id([libraryId, mangaId])
  @@map("library_items")
}

model Bookmark {
  userId    String
  mangaId   String
  chapterId String
  page      Int      @default(0)
  updatedAt DateTime @updatedAt
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  manga     Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mangaId])
  @@map("bookmarks")
}

model History {
  id        String   @id @default(uuid())
  userId    String
  mangaId   String
  chapterId String
  page      Int      @default(0)
  timestamp DateTime @default(now())
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  manga     Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("history")
}

model Progress {
  userId    String
  mangaId   String
  chapterId String
  page      Int      @default(0)
  isRead    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  manga     Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
  @@map("progress")
}

model Rating {
  userId    String
  mangaId   String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  manga     Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mangaId])
  @@map("ratings")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  reply     String?
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model GuestActivity {
  id        String   @id @default(uuid())
  mangaId   String
  guestId   String
  createdAt DateTime @default(now())
  manga     Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([mangaId, guestId])
  @@map("guest_activity")
}

model GuestUser {
  id         String   @id @default(uuid())
  ip         String?
  deviceId   String   @unique
  userAgent  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("guest_users")
}

model GuestChapterRead {
  id        String   @id @default(uuid())
  chapterId String
  guestId   String
  createdAt DateTime @default(now())

  @@unique([chapterId, guestId])
  @@map("guest_chapter_reads")
}

model Category {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  posts BlogPost[]

  @@map("categories")
}

model BlogPost {
  id          String      @id @default(uuid())
  slug        String      @unique
  title       String
  content     String
  description String?
  categoryId  Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  entries     BlogEntry[]
  category    Category?   @relation(fields: [categoryId], references: [id])

  @@map("blog_posts")
}

model BlogEntry {
  id          String   @id @default(uuid())
  blogPostId  String
  title       String
  slug        String
  content     String
  genre       String   @default("")
  description String   @default("")
  imageUrl    String   @default("")
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  blogPost    BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@map("blog_entries")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PopularManga {
  id              String   @id @default(uuid())
  title           String
  imageUrl        String
  mangaDetailLink String
  latestChapter   String?
  updatedAt       DateTime @updatedAt
  latestChapterId String?

  @@map("popular_manga")
}

model PopularCompletedManga {
  id        String   @id @default(uuid())
  title     String
  slug      String
  chapters  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  image     String
  order     Int      @default(0)

  @@map("popular_completed_manga")
}
