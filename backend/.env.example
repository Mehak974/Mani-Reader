# MANI READER — BACKEND CONFIG
# Rename this to .env for development

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/manga_reader?schema=public"

# Auth
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cache (optional)
REDIS_URL=redis://localhost:6379

# Scraper proxy (optional)
SCRAPER_PROXY_URL=http://localhost:8080
SCRAPER_PROXY_ROTATION=false
